# App Settings
PROJECT_NAME="RAG Chatbot SaaS"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings (pgvector / PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot_saas
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot_saas
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chatbot_saas

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration (groq | nim)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
NIM_API_KEY=your_nim_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct

# Embedding Settings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Guardrails
GUARDRAILS_MODEL=unitary/toxic-bert
GUARDRAILS_THRESHOLD=0.7

# RAG Configuration
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50
